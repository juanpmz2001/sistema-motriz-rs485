{
  "schema_version": "1.0.0",
  "profile_id": "differential-2wd-one-svd48-draft",
  "revision": 1,
  "name": "RAFA differential 2WD with one SVD48 - bench draft",
  "description": "Bench profile transcribed from origin/lucho Joystic_iphone.ino. It remains non-activatable until the current ESP-IDF runtime consumes profiles and the physical wiring, deadman channel and limits are measured.",
  "lifecycle": {
    "status": "draft",
    "activation_allowed": false,
    "evidence": [
      "Confirmed topology: one SVD48 uses M1 and M2",
      "Confirmed topology: two driven wheels and two passive casters",
      "origin/lucho maps M1 to left and M2 to right with command signs -1/-1",
      "origin/lucho uses PPM GPIO14, 10 channels, 3000 us sync, 750..2250 us pulses and 300 ms timeout",
      "origin/lucho declares wheelbase 1.60 m, track 0.70 m and wheel radius 0.10 m; it does not prove the body envelope",
      "Body envelope, deadman channel, current limits and controller parameters still require measurement"
    ]
  },
  "board": {
    "target": "esp32s3",
    "variant": "tono-motherboard",
    "revision": "unverified",
    "emergency_stop": {
      "enabled": false
    }
  },
  "io": {
    "rs485_buses": [
      {
        "id": "rs485-main",
        "uart_port": 2,
        "tx_gpio": 17,
        "rx_gpio": 16,
        "direction_control": {
          "type": "auto"
        },
        "baud_rate": 115200,
        "duplex": "half",
        "response_timeout_ms": 100
      }
    ],
    "rc_receivers": [
      {
        "id": "rc-primary",
        "protocol": "ppm",
        "rx_gpio": 14,
        "channel_count": 10,
        "min_frame_channels": 4,
        "sync_threshold_us": 3000,
        "min_pulse_us": 750,
        "max_pulse_us": 2250,
        "stale_timeout_ms": 300,
        "channels": {
          "linear": {
            "index": 1,
            "min": 750,
            "center": 1500,
            "max": 2250,
            "deadband": 20,
            "inverted": false
          },
          "angular": {
            "index": 3,
            "min": 750,
            "center": 1500,
            "max": 2250,
            "deadband": 20,
            "inverted": false
          },
          "speed_scale": {
            "index": 5,
            "min": 750,
            "center": 1500,
            "max": 2250,
            "deadband": 20,
            "inverted": false
          },
          "deadman": {
            "index": 4,
            "min": 750,
            "center": 1500,
            "max": 2250,
            "deadband": 20,
            "inverted": false,
            "active_min": 1700
          }
        }
      }
    ]
  },
