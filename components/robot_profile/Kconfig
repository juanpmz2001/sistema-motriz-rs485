choice BOTFARMS_ROBOT_PROFILE
    prompt "BotFarms robot build profile"
    default BOTFARMS_PROFILE_CURRENT_ROBOT

config BOTFARMS_PROFILE_CURRENT_ROBOT
    bool "Current robot (two dual-channel SVD48 devices)"

config BOTFARMS_PROFILE_BENCH_SINGLE_SVD48_MOTOR
    bool "Bench single SVD48 motor"

config BOTFARMS_PROFILE_BENCH_SINGLE_STEERING_AS5600
    bool "Bench single steering axis with AS5600 feedback"

config BOTFARMS_PROFILE_RAFA
    bool "Rafa sprayer (one dual-channel SVD48 and PPM RC)"
endchoice

config BOTFARMS_RAFA_LAN_ONLY_DIAGNOSTIC
    bool "Temporary Rafa LAN-only authority diagnostic"
    depends on BOTFARMS_PROFILE_RAFA
    default n
    help
        Keep PPM decoding available for read-only receiver diagnostics, but do
        not start the PPM motion source or let the RC/LAN interlock arbitrate
        continuous control. LAN remains subject to its normal 300 ms profile
        TTL, deadman, STOP and SVD/motor-fault safety paths. This is a
        build-selected diagnostic mode, not a runtime command; rebuild Rafa
        without this option after the comparison.
